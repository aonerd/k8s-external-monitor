        "definition": "label_values(kube_event_count{namespace=~\"$namespace\"}, name)",
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "name": "object",
        "label": "Object",
        "query": { "query": "label_values(kube_event_count{namespace=~\"$namespace\"}, name)", "refId": "A" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
